---
import { Image } from 'astro:assets';
import { SITE_TAGLINE, CATEGORIES } from '../consts';
import logoNavy from '../assets/logo-navy.jpg';
const year = new Date().getFullYear();
const catHref = (c: string) => `/category/${encodeURIComponent(c)}/`;
---

<footer class="site-footer">
  <div class="container grid">
    <div class="fbrand">
      <Image src={logoNavy} alt="אוטו טיימס ישראל" widths={[300, 500]} sizes="340px" />
      <p class="muted ftag">{SITE_TAGLINE}</p>
    </div>
    <div>
      <h4>קטגוריות</h4>
      <ul>
        {CATEGORIES.map((c) => <li><a href={catHref(c)}>{c}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>מידע</h4>
      <ul>
        <li><a href="/">עמוד הבית</a></li>
        <li><a href="/archive/">כל הכתבות</a></li>
        <li><a href="/about/">אודות</a></li>
        <li><a href="mailto:info@autotimesisrael.com">צור קשר</a></li>
      </ul>
    </div>
  </div>
  <div class="container bottom">
    <span>© {year} אוטו טיימס ישראל — כל הזכויות שמורות</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #c7cfdb;
    margin-top: 54px;
    padding-top: 50px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 36px;
  }
  .fbrand :global(img) {
    height: 92px;
    width: auto;
    border-radius: 8px;
  }
  .ftag {
    margin-top: 14px;
    max-width: 40ch;
    color: #8f9bad;
    font-family: var(--font);
  }
  h4 {
    font-family: var(--font);
    color: #fff;
    font-size: 0.95rem;
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    font-family: var(--font);
  }
  ul a {
    color: #c7cfdb;
    transition: color 0.15s ease;
  }
  ul a:hover {
    color: var(--accent);
  }
  .bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 20px;
    font-family: var(--font);
    font-size: 0.85rem;
    color: #8f9bad;
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
