---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { CATEGORIES } from '../consts';

const all = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 5 הכתבות האחרונות שהתפרסמו — לסליידר כתבת השער ולרשימת ההירו (דינמי)
const latest = all.slice(0, 5);

// המשפט הראשון מתחילת גוף הכתבה (לתצוגה בהירו)
function firstSentence(body: string | undefined): string {
  const line = (body || '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '') // תמונות
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // קישורים → טקסט
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l && !l.startsWith('#') && !l.startsWith('|') && !l.startsWith('>')) || '';
  const clean = line.replace(/[*_`]/g, '').trim();
  const m = clean.match(/^[\s\S]*?[.!?](?:\s|$)/);
  let s = (m ? m[0] : clean).trim();
  if (s.length > 170) s = s.slice(0, 167).trim() + '…';
  return s;
}

// בלוק לכל קטגוריה — 4 הכתבות האחרונות בקטגוריה
const blocks = CATEGORIES.map((category) => ({
  category,
  items: all.filter((a) => a.data.category === category).slice(0, 4),
})).filter((b) => b.items.length > 0);

const catHref = (c: string) => `/category/${encodeURIComponent(c)}/`;
---

<BaseLayout>
  <!-- ===== HERO: auto-rotating cover slider + headline list (5 latest) ===== -->
  {
    latest.length > 0 && (
      <section class="container hero">
        <div class="slider" data-slider aria-label="כתבות מובילות">
          {latest.map((a, i) => (
            <article class={`slide${i === 0 ? ' active' : ''}`} data-slide={i}>
              <a href={`/articles/${a.id}/`} class="lead-media">
                {a.data.cover && (
                  <Image src={a.data.cover} alt={a.data.coverAlt} widths={[700, 1100, 1500]} sizes="(max-width: 900px) 100vw, 780px" />
                )}
              </a>
              <a href={catHref(a.data.category)} class="lead-cat">{a.data.category}</a>
              <h1><a href={`/articles/${a.id}/`}>{a.data.title}</a></h1>
              <p class="lead-dek">{a.data.description}</p>
              <div class="lead-meta">
                <span>מאת {a.data.author}</span>
                <span class="sep" />
                <FormattedDate date={a.data.pubDate} />
              </div>
            </article>
          ))}
          <div class="slider-dots" role="tablist">
            {latest.map((_, i) => (
              <button class={`dot${i === 0 ? ' active' : ''}`} data-dot={i} aria-label={`כתבה ${i + 1}`} />
            ))}
          </div>
        </div>

        <aside class="hlist">
          {latest.map((a, i) => (
            <a href={`/articles/${a.id}/`} class={`hitem${i === 0 ? ' active' : ''}`} data-hitem={i}>
              {a.data.cover && (
                <span class="hitem-media">
                  <Image src={a.data.cover} alt={a.data.coverAlt} widths={[120, 240]} sizes="120px" />
                </span>
              )}
              <span class="hitem-body">
                <span class="hitem-cat">{a.data.category}</span>
                <h3>{a.data.title}</h3>
                <span class="hitem-excerpt">{firstSentence(a.body)}</span>
                <span class="hitem-more">המשך קריאה ←</span>
              </span>
            </a>
          ))}
        </aside>
      </section>
    )
  }

  <!-- ===== Category blocks ===== -->
  {
    blocks.map((block, i) => (
      <section class:list={['container', 'catblock', i % 2 === 1 && 'catblock--tint']}>
        <div class="blockhead">
          <h2>{block.category}</h2>
          <a class="blockmore" href={catHref(block.category)}>לכל הכתבות ←</a>
        </div>
        <div class="cards2">
          {block.items.map((a) => (
            <ArticleCard article={a} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    display: grid;
    grid-template-columns: 1.62fr 1fr;
    gap: 40px;
    padding-top: 34px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  /* ===== Cover slider (auto-rotating) ===== */
  .slider { position: relative; }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .slide.active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .lead-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
    margin-bottom: 18px;
  }
  .lead-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .slide:hover .lead-media :global(img) {
    transform: scale(1.03);
  }
  .lead-cat,
  .hitem-cat {
    display: inline-block;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .slide h1 {
    font-size: clamp(1.7rem, 3.2vw, 2.7rem);
    line-height: 1.14;
    font-weight: 800;
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .slide h1 a {
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .slide h1 a:hover {
    color: var(--accent);
  }
  .lead-dek {
    font-family: var(--font);
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 12px;
    max-width: 60ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lead-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .lead-meta .sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }
  .slider-dots {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }
  .dot {
    width: 30px;
    height: 5px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--surface-2);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .dot:hover { transform: scaleY(1.4); }
  .dot.active { background: var(--accent); }

  /* ===== Headline list (5 latest: thumbnail + excerpt + read-more) ===== */
  .hlist {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hitem {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    transition: opacity 0.2s ease;
  }
  .hitem:first-child { padding-top: 0; }
  .hitem:last-child { border-bottom: 0; }
  .hitem-media {
    flex: none;
    width: 92px;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm, 6px);
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: 0 0 0 3px transparent;
    transition: box-shadow 0.2s ease;
  }
  .hitem-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .hitem:hover .hitem-media :global(img) { transform: scale(1.06); }
  .hitem.active .hitem-media { box-shadow: 0 0 0 3px var(--accent); }
  .hitem-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .hitem-cat {
    margin-bottom: 4px;
    font-size: 0.7rem;
  }
  .hitem h3 {
    font-size: 1.05rem;
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 6px;
    color: var(--ink);
    transition: color 0.15s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hitem:hover h3,
  .hitem.active h3 { color: var(--accent); }
  .hitem-excerpt {
    font-family: var(--font);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0 0 7px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hitem-more {
    font-family: var(--font);
    font-weight: 800;
    font-size: 0.78rem;
    color: var(--accent);
    align-self: flex-start;
  }

  /* ===== Category blocks ===== */
  .catblock {
    position: relative;
    padding-top: 46px;
    padding-bottom: 10px;
  }
  /* subtle full-width navy tint band behind alternate blocks */
  .catblock--tint {
    padding-bottom: 46px;
    margin-block: 8px;
  }
  .catblock--tint::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -50vw;
    width: 100vw;
    background: linear-gradient(180deg, #eff3f8, #e9eef5);
  }
  .blockhead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 26px;
    border-bottom: 2px solid var(--line);
  }
  .blockhead h2 {
    position: relative;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 800;
    margin: 0;
    padding-bottom: 12px;
  }
  .blockhead h2::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: -2px;
    width: 100%;
    height: 3px;
    background: var(--accent);
  }
  .blockmore {
    font-family: var(--font);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .blockmore:hover {
    color: var(--accent-ink);
  }
  .cards2 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .cards2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cards2 {
      grid-template-columns: 1fr;
    }
    .hitem-media {
      width: 76px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>

<script>
  // כתבת השער — סליידר שמתחלף כל 2 שניות בין 5 הכתבות האחרונות
  const slider = document.querySelector('[data-slider]');
  if (slider) {
    const slides = Array.from(slider.querySelectorAll('.slide'));
    const dots = Array.from(slider.querySelectorAll('[data-dot]'));
    const hitems = Array.from(document.querySelectorAll('[data-hitem]'));
    const n = slides.length;
    let idx = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (next: number) => {
      idx = (next + n) % n;
      slides.forEach((s, i) => s.classList.toggle('active', i === idx));
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
      hitems.forEach((h, i) => h.classList.toggle('active', i === idx));
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (n > 1) timer = setInterval(() => show(idx + 1), 2000);
    };

    dots.forEach((d, i) =>
      d.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        start();
      })
    );
    hitems.forEach((h, i) => {
      h.addEventListener('mouseenter', () => {
        show(i);
        stop();
      });
      h.addEventListener('mouseleave', start);
    });
    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);

    show(0);
    start();
  }
</script>
