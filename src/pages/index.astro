---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FormattedDate from '../components/FormattedDate.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const slides = articles.slice(0, 5); // 5 הכתבות העדכניות ביותר בסליידר
const rest = articles.slice(5);
const trending = rest.slice(0, 3); // רצועת בכותרות
const feature = rest[3]; // כתבת פיצ'ר רחבה
const grid = rest.slice(4, 10); // 6 כתבות בגריד
---

<BaseLayout>
  {
    slides.length > 0 && (
      <section class="hero fullbleed" id="hero" aria-roledescription="קרוסלה" aria-label="כתבות השער">
        <div class="slides" id="heroSlides">
          {slides.map((a, i) => (
            <article class:list={['slide', i === 0 && 'active']} aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="slide-media">
                {a.data.cover ? (
                  <Image src={a.data.cover} alt={a.data.coverAlt} widths={[900, 1400, 2000]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
                ) : (
                  <div class="slide-fallback" />
                )}
              </div>
              <div class="slide-shade" />
              <div class="container slide-inner">
                <span class="hero-eyebrow">כתבת השער · {a.data.category}</span>
                <h1><a href={`/articles/${a.id}/`}>{a.data.title}</a></h1>
                <p class="hero-dek">{a.data.description}</p>
                <div class="hero-meta">
                  <span>{a.data.author}</span>
                  <span class="sep" />
                  <FormattedDate date={a.data.pubDate} />
                </div>
                <a class="hero-cta" href={`/articles/${a.id}/`}>לקריאת הכתבה המלאה ←</a>
              </div>
            </article>
          ))}
        </div>

        <button class="hero-nav prev" id="heroPrev" aria-label="הכתבה הקודמת">‹</button>
        <button class="hero-nav next" id="heroNext" aria-label="הכתבה הבאה">›</button>

        <div class="hero-dots" id="heroDots">
          {slides.map((_, i) => (
            <button class:list={['dot', i === 0 && 'active']} data-i={i} aria-label={`מעבר לשקופית ${i + 1}`} />
          ))}
        </div>
      </section>
    )
  }

  {
    trending.length > 0 && (
      <section class="trending fullbleed">
        <div class="container">
          <div class="trending-head">
            <span class="eyebrow eyebrow--light">בכותרות עכשיו</span>
          </div>
          <div class="trending-grid">
            {trending.map((a, i) => (
              <a href={`/articles/${a.id}/`} class="tcard reveal">
                <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
                <div class="tthumb">
                  {a.data.cover && <Image src={a.data.cover} alt={a.data.coverAlt} widths={[220, 440]} sizes="200px" />}
                </div>
                <div class="tbody">
                  <span class="tcat">{a.data.category}</span>
                  <h3>{a.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="container section">
    <div class="section-head">
      <h2>עוד מהמגזין</h2>
      <a class="more" href="/archive/">כל הכתבות ←</a>
    </div>

    {
      feature && (
        <a href={`/articles/${feature.id}/`} class="feature reveal">
          <div class="feature-media">
            {feature.data.cover && <Image src={feature.data.cover} alt={feature.data.coverAlt} widths={[700, 1200]} sizes="(max-width: 900px) 100vw, 720px" />}
          </div>
          <div class="feature-body">
            <span class="pill">{feature.data.category}</span>
            <h3>{feature.data.title}</h3>
            <p class="feature-dek">{feature.data.description}</p>
            <div class="meta-row">
              <span>{feature.data.author}</span>
              <span class="dot" />
              <FormattedDate date={feature.data.pubDate} />
            </div>
          </div>
        </a>
      )
    }

    <div class="grid grid-3">
      {grid.map((a) => (
        <div class="reveal"><ArticleCard article={a} /></div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== FULL-BLEED HERO SLIDER ===== */
  .hero {
    position: relative;
    height: min(64vh, 600px);
    min-height: 440px;
    overflow: hidden;
    isolation: isolate;
    background: #0c0d11;
  }
  .slides {
    position: absolute;
    inset: 0;
  }
  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.8s ease;
  }
  .slide.active {
    opacity: 1;
    visibility: visible;
  }
  .slide-media,
  .slide-fallback {
    position: absolute;
    inset: 0;
  }
  .slide-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slide.active .slide-media :global(img) {
    animation: heroZoom 8s ease-out forwards;
  }
  @keyframes heroZoom {
    from {
      transform: scale(1.07);
    }
    to {
      transform: scale(1);
    }
  }
  .slide-fallback {
    background: linear-gradient(135deg, #2b2e37, #0c0d11);
  }
  .slide-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 9, 13, 0.12) 0%,
      rgba(8, 9, 13, 0.08) 34%,
      rgba(8, 9, 13, 0.72) 78%,
      rgba(8, 9, 13, 0.94) 100%
    );
  }
  .slide-inner {
    position: relative;
    z-index: 2;
    color: #fff;
    padding-bottom: 54px;
    padding-top: 30px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: #fff;
    background: var(--accent);
    padding: 6px 15px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .hero h1 {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    max-width: 22ch;
    text-wrap: balance;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.4);
  }
  .hero h1 a {
    color: inherit;
  }
  .hero h1 a:hover {
    color: #fff;
  }
  .hero-dek {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    max-width: 60ch;
    margin: 0 0 18px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 22px;
  }
  .hero-meta .sep {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    background: #fff;
    color: var(--ink);
    font-weight: 800;
    font-size: 1rem;
    padding: 13px 26px;
    border-radius: 999px;
    transition: transform 0.16s ease, background 0.16s ease, color 0.16s ease;
  }
  .hero-cta:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-3px);
  }

  /* Slider controls */
  .hero-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .hero-nav:hover {
    background: var(--accent);
  }
  .hero-nav.prev {
    inset-inline-end: 22px;
  }
  .hero-nav.next {
    inset-inline-start: 22px;
  }
  .hero-dots {
    position: absolute;
    bottom: 18px;
    inset-inline-start: 0;
    inset-inline-end: 0;
    z-index: 5;
    display: flex;
    justify-content: center;
    gap: 9px;
  }
  .hero-dots .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .hero-dots .dot.active {
    width: 30px;
    background: var(--accent);
  }

  /* ===== DARK TRENDING BAND ===== */
  .trending {
    background: var(--ink);
    color: #fff;
    padding-block: 50px 60px;
  }
  .eyebrow--light {
    color: #fff;
  }
  .trending-head {
    margin-bottom: 28px;
  }
  .trending-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .tcard {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: center;
    padding-top: 24px;
    border-top: 3px solid rgba(255, 255, 255, 0.14);
    transition: border-color 0.2s ease;
  }
  .tcard:hover {
    border-top-color: var(--accent);
  }
  .tnum {
    grid-row: span 2;
    font-size: 3.2rem;
    font-weight: 900;
    font-style: italic;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.4);
    align-self: start;
  }
  .tcard:hover .tnum {
    -webkit-text-stroke-color: var(--accent);
  }
  .tthumb {
    grid-column: 2;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: #2b2e37;
    margin-bottom: 12px;
  }
  .tthumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .tcard:hover .tthumb :global(img) {
    transform: scale(1.06);
  }
  .tbody {
    grid-column: 2;
  }
  .tcat {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .tbody h3 {
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.32;
    margin: 0;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== FEATURE (wide) ===== */
  .feature {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 40px;
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .feature:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  .feature-media {
    overflow: hidden;
    min-height: 340px;
  }
  .feature-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .feature:hover .feature-media :global(img) {
    transform: scale(1.05);
  }
  .feature-body {
    padding: 44px 46px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }
  .feature-body h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 900;
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .feature-dek {
    font-size: 1.12rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0;
  }

  /* ===== GRID ===== */
  .grid {
    display: grid;
    gap: 26px;
  }
  .grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 980px) {
    .trending-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .feature {
      grid-template-columns: 1fr;
    }
    .feature-media {
      min-height: 240px;
      aspect-ratio: 16 / 9;
    }
    .feature-body {
      padding: 30px 26px;
    }
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .hero {
      height: min(72vh, 540px);
    }
    .slide-inner {
      padding-bottom: 46px;
    }
    .hero-nav {
      display: none;
    }
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // סליידר כתבת השער — אוטומטי, עם חצים ונקודות
  function initHeroSlider() {
    const hero = document.getElementById('hero');
    const slidesWrap = document.getElementById('heroSlides');
    if (!hero || !slidesWrap) return;
    const slides = Array.from(slidesWrap.querySelectorAll('.slide'));
    const dots = Array.from(document.querySelectorAll('#heroDots .dot'));
    if (slides.length < 2) return;

    let idx = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const DELAY = 6000;

    const show = (n: number) => {
      idx = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === idx;
        s.classList.toggle('active', active);
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    };
    const next = () => show(idx + 1);
    const prev = () => show(idx - 1);
    const start = () => {
      stop();
      timer = setInterval(next, DELAY);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
    };

    document.getElementById('heroNext')?.addEventListener('click', () => {
      next();
      start();
    });
    document.getElementById('heroPrev')?.addEventListener('click', () => {
      prev();
      start();
    });
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        show(i);
        start();
      })
    );

    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    start();
  }

  initHeroSlider();
  document.addEventListener('astro:after-swap', initHeroSlider);
</script>
