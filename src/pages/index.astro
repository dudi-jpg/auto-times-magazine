---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { CATEGORIES } from '../consts';

const all = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const lead = all[0];
const headlineList = all.slice(1, 5); // 4 כותרות ברשימת ההירו

// בלוק לכל קטגוריה — 4 הכתבות האחרונות בקטגוריה
const blocks = CATEGORIES.map((category) => ({
  category,
  items: all.filter((a) => a.data.category === category).slice(0, 4),
})).filter((b) => b.items.length > 0);

const catHref = (c: string) => `/category/${encodeURIComponent(c)}/`;
---

<BaseLayout>
  <!-- ===== HERO: lead + headline list ===== -->
  {
    lead && (
      <section class="container hero">
        <article class="lead">
          <a href={`/articles/${lead.id}/`} class="lead-media">
            {lead.data.cover && (
              <Image src={lead.data.cover} alt={lead.data.coverAlt} widths={[700, 1100, 1500]} sizes="(max-width: 900px) 100vw, 780px" />
            )}
          </a>
          <a href={catHref(lead.data.category)} class="lead-cat">{lead.data.category}</a>
          <h1><a href={`/articles/${lead.id}/`}>{lead.data.title}</a></h1>
          <p class="lead-dek">{lead.data.description}</p>
          <div class="lead-meta">
            <span>מאת {lead.data.author}</span>
            <span class="sep" />
            <FormattedDate date={lead.data.pubDate} />
          </div>
        </article>

        <aside class="hlist">
          {headlineList.map((a) => (
            <a href={`/articles/${a.id}/`} class="hitem">
              <span class="hitem-cat">{a.data.category}</span>
              <h3>{a.data.title}</h3>
              <div class="hitem-meta"><FormattedDate date={a.data.pubDate} /></div>
            </a>
          ))}
        </aside>
      </section>
    )
  }

  <!-- ===== Category blocks ===== -->
  {
    blocks.map((block, i) => (
      <section class:list={['container', 'catblock', i % 2 === 1 && 'catblock--tint']}>
        <div class="blockhead">
          <h2>{block.category}</h2>
          <a class="blockmore" href={catHref(block.category)}>לכל הכתבות ←</a>
        </div>
        <div class="cards2">
          {block.items.map((a) => (
            <ArticleCard article={a} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    display: grid;
    grid-template-columns: 1.62fr 1fr;
    gap: 40px;
    padding-top: 34px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  .lead-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
    margin-bottom: 18px;
  }
  .lead-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .lead:hover .lead-media :global(img) {
    transform: scale(1.03);
  }
  .lead-cat,
  .hitem-cat {
    display: inline-block;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .lead h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.14;
    font-weight: 800;
    margin: 0 0 14px;
  }
  .lead h1 a {
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .lead h1 a:hover {
    color: var(--accent);
  }
  .lead-dek {
    font-family: var(--font);
    font-size: 1.12rem;
    line-height: 1.65;
    color: var(--ink-soft);
    margin: 0 0 14px;
    max-width: 60ch;
  }
  .lead-meta,
  .hitem-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .lead-meta .sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Headline list */
  .hlist {
    display: flex;
    flex-direction: column;
  }
  .hitem {
    display: block;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .hitem:first-child {
    padding-top: 0;
  }
  .hitem:last-child {
    border-bottom: 0;
  }
  .hitem-cat {
    margin-bottom: 6px;
    font-size: 0.72rem;
  }
  .hitem h3 {
    font-size: 1.22rem;
    line-height: 1.3;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .hitem:hover h3 {
    color: var(--accent);
  }
  .hitem-meta {
    font-size: 0.8rem;
  }

  /* ===== Category blocks ===== */
  .catblock {
    position: relative;
    padding-top: 46px;
    padding-bottom: 10px;
  }
  /* subtle full-width navy tint band behind alternate blocks */
  .catblock--tint {
    padding-bottom: 46px;
    margin-block: 8px;
  }
  .catblock--tint::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: 50%;
    margin-left: -50vw;
    width: 100vw;
    background: linear-gradient(180deg, #eff3f8, #e9eef5);
  }
  .blockhead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 26px;
    border-bottom: 2px solid var(--line);
  }
  .blockhead h2 {
    position: relative;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 800;
    margin: 0;
    padding-bottom: 12px;
  }
  .blockhead h2::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: -2px;
    width: 100%;
    height: 3px;
    background: var(--accent);
  }
  .blockmore {
    font-family: var(--font);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--accent);
    white-space: nowrap;
  }
  .blockmore:hover {
    color: var(--accent-ink);
  }
  .cards2 {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .cards2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cards2 {
      grid-template-columns: 1fr;
    }
  }
</style>
