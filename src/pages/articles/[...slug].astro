---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { title, description, category, author, pubDate, cover, coverAlt } = article.data;
const { Content } = await render(article);

// כתבות קשורות מאותה קטגוריה
const related = (await getCollection('articles'))
  .filter((a) => a.id !== article.id && a.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={title} description={description} image={cover?.src}>
  <article class="post">
    <div class="container narrow">
      <a href={`/category/${encodeURIComponent(category)}/`} class="pill">{category}</a>
      <h1>{title}</h1>
      <p class="dek">{description}</p>
      <div class="meta-row byline">
        <span>מאת {author}</span>
        <span class="dot"></span>
        <FormattedDate date={pubDate} />
      </div>
    </div>

    {
      cover && (
        <div class="container">
          <figure class="hero-figure">
            <Image src={cover} alt={coverAlt} widths={[600, 1200, 1600]} sizes="(max-width: 1100px) 100vw, 1100px" />
            {coverAlt && <figcaption class="muted">{coverAlt}</figcaption>}
          </figure>
        </div>
      )
    }

    <div class="container narrow">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="container section related">
        <div class="section-head">
          <h2>עוד ב{category}</h2>
        </div>
        <div class="rel-grid">
          {related.map((a) => (
            <ArticleCard article={a} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .narrow {
    max-width: 760px;
  }
  .post {
    padding-top: 40px;
  }
  .post h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin: 14px 0 12px;
  }
  .dek {
    font-size: 1.2rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 16px;
  }
  .byline {
    padding-bottom: 26px;
    border-bottom: 1px solid var(--line);
  }
  .hero-figure {
    margin: 0 0 34px;
  }
  .hero-figure :global(img) {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .hero-figure figcaption {
    font-size: 0.85rem;
    text-align: center;
    margin-top: 10px;
  }

  /* Article body typography */
  .prose {
    font-size: 1.13rem;
    line-height: 1.85;
    color: var(--ink);
  }
  .prose :global(h2) {
    font-size: 1.6rem;
    margin: 1.6em 0 0.5em;
  }
  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 1.4em 0 0.4em;
  }
  .prose :global(p) {
    margin: 0 0 1.1em;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2em;
    padding-inline-start: 1.4em;
  }
  .prose :global(li) {
    margin-bottom: 0.5em;
  }
  .prose :global(img) {
    border-radius: var(--radius);
    margin: 1.6em 0;
  }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 4px 20px;
    border-inline-start: 4px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .prose :global(strong) {
    font-weight: 800;
  }

  .related {
    border-top: 1px solid var(--line);
    margin-top: 20px;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 820px) {
    .rel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
